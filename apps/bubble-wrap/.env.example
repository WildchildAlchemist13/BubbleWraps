# Copy to .env and fill in when you're ready for real ads and purchases.
# Development builds always use Google's test ads, whatever you put here.

# AdMob interstitial ad unit IDs (AdMob console → Apps → Ad units)
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=

# RevenueCat public SDK keys (RevenueCat → Project settings → API keys). These are safe in the app.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
